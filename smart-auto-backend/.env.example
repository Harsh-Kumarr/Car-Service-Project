# Server configuration
PORT=5000

# MongoDB Connection String (Atlas URI or Local URI)
MONGO_URI=your_mongodb_connection_string

# JSON Web Token (JWT) secret key used to sign and verify auth tokens
JWT_SECRET=your_jwt_secret_key

# SMTP configuration for Nodemailer (Gmail App Passwords recommended)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Razorpay payment gateway credentials for checkout integration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Google Gemini API key for AI diagnostic completions
GEMINI_API_KEY=your_gemini_api_key
